<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600" prefWidth="500" spacing="12" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.NoteController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label text="My Notebook" />

    <Label text="Note Title:" />

    <TextField fx:id="titleField" promptText="Enter note title" />

    <Label text="Note Content:" />

    <TextArea fx:id="contentArea" prefHeight="150" promptText="Write your note here..." />

    <Button onAction="#addNote" text="Add" />

    <Label text="Saved Notes:" />

    <TextArea fx:id="notesDisplay" editable="false" prefHeight="200" wrapText="true" />

</VBox>
